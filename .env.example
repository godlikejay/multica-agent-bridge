# Non-secret Compose settings. Do not put a PAT or password here.
# API URL applies to single-connection production installs.
MULTICA_SERVER_URL=https://api.example.invalid
# Replace these placeholders with the outputs of id -u and id -g.
BRIDGE_UID=
BRIDGE_GID=
# BRIDGE_DEVICE_NAME=multica-agent-bridge
# Maximum simultaneous Runs across this daemon. Agent and Runtime caps also apply.
# BRIDGE_MAX_ACTIVE_RUNS=4
# Set after registration if you want to lock task processing to one runtime.
# BRIDGE_EXPECTED_RUNTIME_ID=
# Leave empty to build locally; set a GHCR tag or digest to pull.
BRIDGE_IMAGE=
